# Sponnect Backend Environment Variables Example
# Do not commit real passwords, secrets, or API keys.

PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/test?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# SMTP Configuration (Feature 2 - Email Notifications)
# Configure with your SMTP provider (e.g. Gmail App Password, Mailgun, SendGrid, Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM="Sponnect Platform" <no-reply@sponnect.com>

# Optional SMS Readiness (Feature 3 - Future Extension)
# SMS_ENABLED=false
